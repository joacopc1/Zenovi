NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_OAUTH_REDIRECT_URI=https://app.zenovi.app/api/integrations/instagram/callback
META_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
CRON_SECRET=long_random_secret_used_by_vercel_cron
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
# Optional. Zenovi uses gemini-3.7-flash when the primary model is temporarily unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Claude: the Director chat and the analysis fallback. See docs/ai-providers.md.
ANTHROPIC_API_KEY=sk-ant-your_key

# CAPTCHA del login (Cloudflare Turnstile). Clave pública del sitio; la secreta va sólo en Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Confirmar el registro con código en vez de enlace. Activarlo recién con SMTP propio y la
# plantilla de supabase/templates/confirm-signup.html cargada en Supabase.
NEXT_PUBLIC_AUTH_EMAIL_CODE=false
